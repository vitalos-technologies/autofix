
# --- Autofix platform (appended by /bootstrap) ---
# Hosts
NEXT_PUBLIC_ADMIN_HOST=autofix.vitalos.co.uk
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=autofix.vitalos.co.uk
DEV_TENANT_ROOT_DOMAIN=localhost:3000

# Vercel domains API (server only, team-scoped token)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DOMAIN_CNAME_TARGET=cname.vercel-dns-0.com

# Government vehicle data (server only)
DVLA_VES_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
DVSA_MOT_TOKEN_URL=
DVSA_MOT_SCOPE=

# Messaging (server only). MESSAGING_MODE=mock sends nothing.
MESSAGING_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_BASE_URL=
TWILIO_WEBHOOK_BASE_URL=

# Agent tool API
AGENT_TOKEN_PEPPER=

# Askbridge (P4.6, docs/autofix/askbridge.md): public widget script; server-only sync URL and signing secret
NEXT_PUBLIC_ASKBRIDGE_WIDGET_URL=
ASKBRIDGE_SYNC_URL=
ASKBRIDGE_WEBHOOK_SECRET=

# Reminder link tokens (/r/{token}) are random and stored hashed: no secret needed.
