{
  "name": "autofix-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Pitline AI front desk on calls: Twilio ConversationRelay WebSocket + Claude, booking through Pitline's agent tool API.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
