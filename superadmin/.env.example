# Pitline Super Admin configuration. Copy to .env for local development (never commit .env).
# In production every value is set as a platform secret or environment variable instead.

# --- Django core -------------------------------------------------------------------------------
# config.settings.dev (local), config.settings.test (pytest), config.settings.prod (live).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod, at least 50 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Leave empty locally: dev generates one into the ignored .dev_secret_key file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# development, staging or production. Shown as a badge; also the status endpoint's "environment".
APP_ENVIRONMENT=development
# Origin used in one-time set-password links (the path, prefix included, is added). Prod: https://pitline.co.uk
APP_BASE_URL=http://localhost:8000
# Prod: pitline.co.uk (the proxy passes the public host) and https://pitline.co.uk.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Path mode: served at https://pitline.co.uk/superadmin (DECISIONS D18) ---------------
# The Pitline app's proxy (src/proxy.ts) forwards /superadmin/* here with SUPERADMIN_PROXY_SECRET in the
# x-autofix-superadmin-proxy header. With the secret set, every request without it is a bare 404.
# Empty prefix: the app answers at the root of its own host (local development).
# Locally through the Next.js app: SUPERADMIN_PATH_PREFIX=/superadmin here, and in the repo's .env.local
# SUPERADMIN_ORIGIN=http://localhost:8000 with the same secret; then open http://localhost:3000/superadmin
SUPERADMIN_PATH_PREFIX=
# 32+ random characters in prod; the same value is Vercel's SUPERADMIN_PROXY_SECRET (Sensitive).
SUPERADMIN_PROXY_SECRET=

# --- The super admin's own database (users, OTP devices, sessions, axes, history, audit) -----------
# Defaults to SQLite (db.sqlite3) when unset. Prod: PostgreSQL 17 with sslmode=require.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- Pitline data (the `autofix` alias) ----------------------------------------------------------
# Pitline's Supabase Postgres as the least-privilege role autofix_superadmin (migration
# 20261028004000_superadmin_role.sql). Its password is set out of band, never in a migration:
#   alter role autofix_superadmin with login password '<generated>';
# Local: postgres://autofix_superadmin:<local password>@127.0.0.1:54322/postgres
# Prod: the Supabase session pooler, user "autofix_superadmin.<project-ref>", ?sslmode=require
# Empty: Pitline pages say "Pitline data is not connected".
AUTOFIX_DATABASE_URL=
# Startup options mirror the role's defaults (read-only sessions, search_path=superadmin). Set False if a
# pooler rejects startup options; the role-level defaults still apply.
AUTOFIX_DB_STARTUP_OPTIONS=True
# The Pitline app, for the "View as support" hand-off (only the garage id is appended). Prod: https only.
AUTOFIX_APP_URL=http://localhost:3000
# This super admin's public address, returned as superadminUrl by the status endpoint.
# Prod: https://pitline.co.uk/superadmin
AUTOFIX_SUPERADMIN_URL=http://localhost:8000
# Bearer token for GET /api/platform/v1/status (Vitalos Product Pipeline, ADR-044). 32+ characters in prod.
# Empty: the endpoint answers 503. The same value goes into the platform's AUTOFIX_STATUS_TOKEN.
AUTOFIX_STATUS_TOKEN=
# Voicemail playback on Calls: the Twilio account Pitline records voicemails on (the Pitline app's own
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN). Recordings are fetched server-side; the browser never gets
# a Twilio link. Empty: the Calls page works and playback says it is not set up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Hours before an onboarding garage counts as stuck.
ONBOARDING_STUCK_HOURS=48

# --- HTTPS and proxies (prod) ------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Reverse-proxy hops trusted for X-Forwarded-For (client IP for lockouts). Azure Container Apps: 1.
TRUSTED_PROXY_COUNT=0

# --- Bootstrap administrator -------------------------------------------------------------------
# Used by `manage.py create_superadmin` (release job). The password is only ever read from here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# At least 12 characters. Keep it in the secrets store, never in git.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Authentication hardening ------------------------------------------------------------------
OTP_REQUIRED_FOR_SUPERADMIN=True
# Prod defaults True: TOTP for every role, and a fresh code with every change to Pitline, personal-data
# view, user change and API token (it shares an origin with the Pitline app).
OTP_REQUIRED_FOR_ALL=False
AUTOFIX_STEP_UP=False
# The single primary owner, created by `manage.py create_owner` with no password; then
# `manage.py issue_setup_link --email <it>` prints a one-time 30-minute set-password link.
PRIMARY_OWNER_EMAIL=
DEFAULT_SIGNIN_EMAIL=
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- Logging and errors ------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
