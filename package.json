{
  "name": "autofix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local-invoicing": "playwright test --config playwright.local-invoicing.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.garage.config.ts --project=smoke-chromium",
    "test:e2e:booking": "playwright test --config playwright.garage.config.ts --project=booking-chromium --project=booking-mobile --project=booking-390 --project=legal-mobile",
    "test:e2e:manage": "playwright test --config playwright.garage.config.ts --project=manage-mobile",
    "test:e2e:admin": "playwright test --config playwright.garage.config.ts --project=admin-chromium --project=admin-390 --project=admin-pages",
    "test:e2e:settings": "playwright test --config playwright.garage.config.ts --project=settings",
    "test:e2e:super-admin": "playwright test --config playwright.garage.config.ts --project=super-admin",
    "test:e2e:booking-page": "playwright test --config playwright.garage.config.ts --project=booking-page-settings",
    "test:e2e:legal": "playwright test --config playwright.garage.config.ts --project=legal-mobile",
    "test:e2e:signup": "playwright test --config playwright.garage.config.ts --project=signup",
    "test:e2e:gate3": "playwright test --config playwright.garage.config.ts --project=gate3",
    "test:e2e:p5-fleet-accounts": "playwright test --config playwright.garage.config.ts --project=p5-fleet-accounts",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:askbridge": "node scripts/lighthouse-askbridge.mjs",
    "test:load": "node scripts/load/slots-load.mjs",
    "email:preview": "node scripts/render-email-previews.mjs",
    "deploy:email-worker": "wrangler deploy --config workers/enquiry-email/wrangler.jsonc",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.6.0",
    "@sentry/nextjs": "10.69.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "next": "^16.0.0",
    "postal-mime": "2.7.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "resend": "^6.1.0",
    "tailwind-merge": "^3.3.1",
    "uqr": "0.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "jiti": "2.7.0",
    "jsdom": "^27.0.1",
    "pdfjs-dist": "6.2.108",
    "supabase": "2.113.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "4.122.0",
    "yaml": "2.8.1"
  }
}
