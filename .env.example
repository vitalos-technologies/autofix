# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only
SUPABASE_SECRET_KEY=
# Vehicle lookup: mock (fake vehicle, no network; the default when unset outside
# production), composite (DVLA VES + DVSA MOT History, Vehicle Data Global only
# when make or model is missing; each source runs only when its credentials are
# set), dvla, or vehicle-data-global (SOB's single provider).
# Autofix: set VEHICLE_LOOKUP_PROVIDER=composite once the DVLA/DVSA keys are bound.
VEHICLE_LOOKUP_PROVIDER=vehicle-data-global
VEHICLE_DATA_GLOBAL_API_KEY=
VEHICLE_DATA_GLOBAL_BASE_URL=https://uk.api.vehicledataglobal.com
VEHICLE_DATA_GLOBAL_PACKAGE=VehicleDetails
RESEND_API_KEY=
# Platform sender. Mail goes out as "<garage name>" <this address>; replies go to the garage's own email.
RESEND_FROM_EMAIL=Autofix <notifications@autofix.vitalos.co.uk>
# Optional fallback reply-to for a garage with no email address.
RESEND_REPLY_TO=
ENQUIRY_REPLY_DOMAIN=reply.autofix.vitalos.co.uk
# Temporary rollout fallback only; ENQUIRY_REPLY_DOMAIN is canonical.
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=
# Sign-up (P4.4) Google Places (New), server only. PLACES_PROVIDER: unset = live with a key, else mock
# fixtures outside production and off (manual entry) on Vercel production; or mock / live / off.
GOOGLE_PLACES_API_KEY=
PLACES_PROVIDER=
TURNSTILE_SECRET_KEY=
# Signs manage-booking links, the manage session cookie and calendar downloads (at least 32 random characters).
BOOKING_MANAGEMENT_SECRET=
# Seals the booking-flow cookies (af_booking, af_booked). At least 32 random characters.
# Unset: BOOKING_MANAGEMENT_SECRET is used; production refuses to run the booking pages with neither.
BOOKING_STATE_SECRET=
# fake = in-memory booking engine for UI work (ignored in production builds).
BOOKING_ENGINE=
# Vercel Cron and POST /api/jobs/drain send `Authorization: Bearer <CRON_SECRET>`. At least 16 random
# characters (shorter or unset refuses every call). Vercel sends it to crons automatically.
CRON_SECRET=
SENTRY_DSN=
LEGAL_COPY_APPROVED=false
COOKIE_CONFIGURATION_APPROVED=false

# Optional Sentry source-map upload credentials used during deployment builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# --- Autofix platform (appended by /bootstrap) ---
# Hosts
NEXT_PUBLIC_ADMIN_HOST=autofix.vitalos.co.uk
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=autofix.vitalos.co.uk
DEV_TENANT_ROOT_DOMAIN=localhost:3000

# Vercel domains API (server only, team-scoped token)
# VERCEL_DOMAINS_MODE=mock keeps garage domains in memory; set live (with the token and project ID) to call Vercel.
VERCEL_DOMAINS_MODE=mock
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DOMAIN_CNAME_TARGET=cname.vercel-dns-0.com

# Government vehicle data (server only), used by VEHICLE_LOOKUP_PROVIDER=composite
DVLA_VES_API_KEY=
# live (default) or uat (DVLA's test environment; test VRNs such as AA19AAA only)
DVLA_VES_ENVIRONMENT=live
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
# From DVSA's credentials email: https://login.microsoftonline.com/<tenant id>/oauth2/v2.0/token
DVSA_MOT_TOKEN_URL=
DVSA_MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
# 24 h vehicle_facts cache key = HMAC-SHA-256(normalised registration, pepper).
# At least 32 random characters (e.g. `openssl rand -base64 48`); changing it empties the cache.
# Unset: each server instance keeps its own in-memory cache instead of the shared table.
VEHICLE_FACTS_PEPPER=

# Messaging (server only). MESSAGING_MODE=mock sends nothing: booking emails, SMS and
# WhatsApp go to an in-memory outbox. Production must set MESSAGING_MODE=live for booking
# confirmations to reach customers (enquiry and invoice email still use Resend directly).
MESSAGING_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# Public https origin Twilio posts delivery receipts to (+ /api/webhooks/twilio/status). Empty = no status callbacks.
# Optional: delivery receipts default to NEXT_PUBLIC_SITE_URL when it is https.
TWILIO_STATUS_CALLBACK_BASE_URL=
# Public origin (optionally with a path prefix) Twilio calls the webhooks on, e.g. https://autofix.vitalos.co.uk.
# X-Twilio-Signature is checked against this + the request path. Unset: rebuilt from X-Forwarded-Proto/Host, then Host.
# The webhooks also need TWILIO_AUTH_TOKEN (without it they answer 503).
TWILIO_WEBHOOK_BASE_URL=

# Askbridge AI front desk (P4.6, docs/autofix/askbridge.md). Optional: without them the chat stays hidden
# and knowledge syncs stay in the mock outbox (non-production) or retry (production).
# Public widget script (https; a http://127.0.0.1 stub is allowed anywhere but Vercel production).
NEXT_PUBLIC_ASKBRIDGE_WIDGET_URL=
# Server only: where knowledge syncs are POSTed, and the HMAC-SHA-256 signing secret (32+ random characters).
ASKBRIDGE_SYNC_URL=
ASKBRIDGE_WEBHOOK_SECRET=

# Agent tool API: 32+ random characters; keys the HMAC stored for each agent token (rotating it revokes every token)
AGENT_TOKEN_PEPPER=

# Reminder link tokens (/r/{token}) are 32 random bytes stored only as a SHA-256 hash: no secret needed.

# Plans and billing (P5.2, D17). Server only; none of these may be NEXT_PUBLIC_.
# Billing for Autofix's own plans: "mock" (default; "Upgrade" becomes "Request Pro" for Vitalos) or "stripe".
# Stripe is TEST MODE ONLY: a sk_live_/rk_live_ key is refused and the mock is used instead.
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/webhooks/billing/stripe (whsec_...).
STRIPE_BILLING_WEBHOOK_SECRET=
# Price ids (price_...) of the Pro plan and of one extra site.
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXTRA_SITE=
# PLACEHOLDERS until Temitope sets prices and allowances (DECISIONS "Waiting on Temitope"). Empty = "to be confirmed".
PLAN_ESSENTIALS_PRICE_PENCE=
PLAN_PRO_PRICE_PENCE=
PLAN_ESSENTIALS_SMS_ALLOWANCE=
PLAN_PRO_SMS_ALLOWANCE=
PLAN_PRO_AI_MINUTES=
PLAN_EXTRA_SITE_PRICE_PENCE=
# SMS segments and AI minutes are metered per garage per month; set to "off" to stop recording (never blocks a send).
USAGE_METERING=on

# P5.4 Payments (deposits, pay-by-link invoices, no-show fees). Server only; never NEXT_PUBLIC_.
# "mock" (default; a test payment on the garage host's /pay page, refused on Vercel production) or "stripe".
# Stripe Connect is TEST MODE ONLY and uses STRIPE_SECRET_KEY above (sk_test_/rk_test_; a live key is refused).
PAYMENTS_PROVIDER=mock
# Signing secret of the Connect webhook endpoint /api/webhooks/payments/stripe (whsec_...).
STRIPE_PAYMENTS_WEBHOOK_SECRET=
